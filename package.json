{
  "name": "mycelium",
  "private": true,
  "version": "0.0.0",
  "description": "Shared toolkit for personal-knowledge agent plugins: pluggable LLM/embedding providers, a local-first semantic index, and an MCP server bridge.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
