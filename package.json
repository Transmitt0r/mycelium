{
  "name": "mycelium",
  "private": true,
  "version": "0.0.0",
  "description": "Shared toolkit for personal-knowledge agent plugins: pluggable LLM/embedding providers, a local-first semantic index, and an MCP server bridge.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "tsc -b --clean",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
