{
  "name": "@transmitt0r/mycelium-openapi-codegen",
  "version": "0.0.0",
  "description": "Fetch an OpenAPI schema and generate TypeScript types from it — fetch-to-tempfile lifecycle plus an isolated openapi-typescript run, so callers only supply their own schema-fetching logic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Transmitt0r/mycelium.git",
    "directory": "tools/openapi-codegen"
  },
  "keywords": [
    "openapi",
    "codegen",
    "openapi-typescript"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
