{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "extends": ["./tools/tooling-config/biome.preset.json"],
  "files": {
    "includes": [
      "core/*/src/**",
      "tools/*/src/**",
      "apps/*/src/**",
      "*.json",
      "core/*/*.json",
      "tools/*/*.json",
      "apps/*/*.json"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/*/src/generated/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
