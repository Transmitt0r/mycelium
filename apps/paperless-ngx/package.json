{
  "name": "@transmitt0r/openclaw-plugin-paperless-ngx",
  "version": "1.4.0",
  "description": "OpenClaw plugin for paperless-ngx",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "paperless-ngx",
    "paperless",
    "document-management"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Transmitt0r/mycelium.git",
    "directory": "apps/paperless-ngx"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "openclaw": ">=2026.7.0",
      "pluginApi": ">=2026.7.0"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "start:mcp": "node dist/mcp-server.js",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@transmitt0r/mycelium-embed": "workspace:*",
    "@transmitt0r/mycelium-index": "workspace:*",
    "@transmitt0r/mycelium-mcp": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "typebox": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@semantic-release/exec": "^7.1.0",
    "@transmitt0r/mycelium-openapi-codegen": "workspace:*",
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "semantic-release": "^25.0.8",
    "semantic-release-monorepo": "^8.0.2",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
